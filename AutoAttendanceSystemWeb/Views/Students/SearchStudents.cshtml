
<h4>Search Student</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="ShowSearchStudents">
            <div class="form-group">
                <label for="StudentName" class="control-label">Name</label>
                <input name="StudentName" class="form-control" />
            </div>
            <div class="form-group">
                <label for="StudentId" class="control-label">Id</label>
                <input name="StudentId" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Search" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

